## .mozconfig for Mercury Browser (Linux) ARM64

# Build only Mercury
ac_add_options --enable-application=browser
ac_add_options --disable-artifact-builds

# Build for Linux
ac_add_options --target=aarch64-linux-gnu
ac_add_options --enable-default-toolkit=cairo-gtk3-x11-wayland
ac_add_options --enable-bootstrap
export MOZ_INCLUDE_SOURCE_INFO=1

# Optimization settings
ac_add_options --enable-release
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-debug-js-modules
ac_add_options --disable-tests
ac_add_options --enable-strip
ac_add_options --enable-install-strip
ac_add_options --disable-elf-hack
ac_add_options --enable-jemalloc
ac_add_options --enable-optimize="-O3 -march=armv8-a+simd -mtune=cortex-a72"
ac_add_options --enable-rust-simd
ac_add_options --enable-hardening
ac_add_options --disable-dmd
ac_add_options --disable-necko-wifi
#ac_add_options --disable-trace-logging
mk_add_options MOZILLA_OFFICIAL=1
MOZILLA_OFFICIAL=1
export MOZILLA_OFFICIAL=1
mk_add_options MOZ_OPTIMIZE=1
MOZ_OPTIMIZE=1
export MOZ_OPTIMIZE=1
export STRIP_FLAGS="--strip-debug --strip-unneeded"

# Media settings
ac_add_options --enable-sandbox
ac_add_options --enable-raw
ac_add_options --enable-webrtc
ac_add_options --enable-pulseaudio
ac_add_options --enable-alsa
ac_add_options --enable-jxl

# Add-ons
# Extension signing is enforced (no unsigned scopes / sideloading).

# Client settings
ac_add_options --disable-parental-controls
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --enable-geckodriver
ac_add_options --disable-default-browser-agent
ac_add_options --disable-backgroundtasks
# ${changeset} is a Mercurial leftover and is empty on git checkouts.
# An empty MOZ_SOURCE_CHANGESET makes build/variables.py call hg and fail.
# Use the Firefox source tree's git HEAD (override by exporting it first).
export MOZ_SOURCE_CHANGESET="${MOZ_SOURCE_CHANGESET:-$(git rev-parse HEAD 2>/dev/null || echo mercury)}"
mk_add_options MOZ_CRASHREPORTER=0
mk_add_options MOZ_DATA_REPORTING=0
mk_add_options MOZ_SERVICES_HEALTHREPORT=0
mk_add_options MOZ_TELEMETRY_REPORTING=
export MOZ_CRASHREPORTER=0
export MOZ_DATA_REPORTING=0
export MOZ_TELEMETRY_REPORTING=
export MOZ_PACKAGE_JSSHELL=1

# API Keys
# None: Mercury ships without Google (or other) API keys.

# Branding
ac_add_options --with-app-name=mercury
ac_add_options --with-app-basename=Mercury
ac_add_options --with-branding=browser/branding/mercury
ac_add_options --with-l10n-base=$PWD/browser/locales/en-US
ac_add_options --with-distribution-id=com.alex313031.mercury
#-app=/home/alex/bin/Mercury/application.ini

# Make flags (set to number of CPU cores)
mk_add_options MOZ_MAKE_FLAGS="${MOZ_MAKE_FLAGS:--j$(nproc 2>/dev/null || echo 16)}"

# Autoclobber
mk_add_options AUTOCLOBBER=1
export AUTOCLOBBER=1

# Set Rust -Copt-level=3 (C/C++ use -O3 via --enable-optimize and CFLAGS)
export RUSTC_OPT_LEVEL="3"
ac_add_options RUSTC_OPT_LEVEL="3"

# Enable PGO/LTO
#export MOZ_PGO=1
#ac_add_options MOZ_PGO=1

# Compiler, Linker, and Rust flags
export CFLAGS="-O3 -ffp-contract=fast -march=armv8-a+simd -mtune=cortex-a72 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -mbranch-protection=standard"
export CPPFLAGS="-O3 -ffp-contract=fast -march=armv8-a+simd -mtune=cortex-a72 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -mbranch-protection=standard"
export CXXFLAGS="-O3 -ffp-contract=fast -march=armv8-a+simd -mtune=cortex-a72 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -mbranch-protection=standard"
export LDFLAGS="-Wl,-O3 -Wl,-mllvm,-fp-contract=fast -march=armv8-a+simd"
#export MOZ_LTO_LDFLAGS="-Wl,-mllvm,-polly"
export RUSTFLAGS="-C target-feature=+neon -C codegen-units=1"
# Mercury env-driven Fast Dev / Cross-PGO / Full-LTO controls
if [ "${MERCURY_FAST_BUILD:-0}" = "1" ]; then
    ac_add_options --disable-geckodriver
    export RUSTC_OPT_LEVEL="2"
    ac_add_options RUSTC_OPT_LEVEL="2"
    export RUSTFLAGS="${RUSTFLAGS} -C codegen-units=16"
else
    if [ "${MERCURY_PGO_GENERATE:-0}" = "1" ] || [ -n "${GEN_PGO:-}" ]; then
        ac_add_options --enable-profile-generate=cross
    elif [ -n "${MERCURY_PGO_PROFILE:-}" ]; then
        if [ ! -f "${MERCURY_PGO_PROFILE}" ]; then
            echo "ERROR: MERCURY_PGO_PROFILE file not found: ${MERCURY_PGO_PROFILE}" >&2
            exit 1
        fi
        ac_add_options --enable-profile-use=cross
        ac_add_options --with-pgo-profile-path="${MERCURY_PGO_PROFILE}"
        if [ -n "${MERCURY_PGO_JARLOG:-}" ] && [ -f "${MERCURY_PGO_JARLOG}" ]; then
            ac_add_options --with-pgo-jarlog="${MERCURY_PGO_JARLOG}"
        fi
    elif [ -n "${USE_PGO:-}" ]; then
        ac_add_options --enable-profile-use=cross
    fi
    if [ "${MERCURY_PGO_GENERATE:-0}" != "1" ] && [ -z "${GEN_PGO:-}" ]; then
        _mercury_lto="${MERCURY_LTO_MODE:-full}"
        if [ "$_mercury_lto" != "off" ] && [ "$_mercury_lto" != "none" ]; then
            ac_add_options --enable-lto="${_mercury_lto}"
        fi
        unset _mercury_lto
    fi
    if [ "${MERCURY_BOLT:-0}" = "1" ] && [ "${MERCURY_PGO_GENERATE:-0}" != "1" ] && [ -z "${GEN_PGO:-}" ]; then
        export LDFLAGS="${LDFLAGS} -Wl,--emit-relocs"
    fi
fi

export VERBOSE=1
