+static bool NormalizeMercuryJitOrigin(const nsACString& aInput,
+                                      nsACString& aOut) {
+  nsAutoCString entry(aInput);
+  entry.Trim(" \t\r\n");
+  if (entry.IsEmpty()) {
+    return false;
+  }
+
+  char* entryData = entry.BeginWriting();
+  for (size_t i = 0; i < entry.Length(); ++i) {
+    if (entryData[i] >= 'A' && entryData[i] <= 'Z') {
+      entryData[i] = static_cast<char>(entryData[i] - 'A' + 'a');
+    }
+  }
+
+  nsAutoCString scheme;
+  nsAutoCString rest;
+  if (StringBeginsWith(entry, "https://"_ns)) {
+    scheme.AssignLiteral("https://");
+    rest.Assign(Substring(entry, 8));
+  } else if (StringBeginsWith(entry, "http://"_ns)) {
+    scheme.AssignLiteral("http://");
+    rest.Assign(Substring(entry, 7));
+  } else {
+    if (entry.Find("://") != kNotFound) {
+      return false;
+    }
+    if (entry.First() != '[') {
+      int32_t colonIdx = entry.FindChar(':');
+      if (colonIdx != kNotFound) {
+        // Bare host:port is allowed only if the suffix (ignoring at most one
+        // trailing slash) is strictly digits; reject non-http(s) schemes like
+        // "javascript:", "file:", "about:", "data:".
+        nsAutoCString afterColon(Substring(entry, colonIdx + 1));
+        if (!afterColon.IsEmpty() && afterColon.Last() == '/') {
+          afterColon.Truncate(afterColon.Length() - 1);
+        }
+        if (afterColon.IsEmpty()) {
+          return false;
+        }
+        for (size_t i = 0; i < afterColon.Length(); ++i) {
+          char ch = afterColon[i];
+          if (ch < '0' || ch > '9') {
+            return false;
+          }
+        }
+      }
+    }
+    scheme.AssignLiteral("https://");
+    rest.Assign(entry);
+  }
+
+  // Strip a single trailing slash on bare root origins (e.g. "https://a.com/"),
+  // while still rejecting any path or double slash below.
+  if (!rest.IsEmpty() && rest.Last() == '/') {
+    rest.Truncate(rest.Length() - 1);
+  }
+  if (rest.IsEmpty()) {
+    return false;
+  }
+
+  // Reject wildcards, paths, queries, fragments, userinfo, OriginAttributes,
+  // backslashes, or internal whitespace.
+  for (size_t i = 0; i < rest.Length(); ++i) {
+    char ch = rest[i];
+    if (ch == '/' || ch == '?' || ch == '#' || ch == '@' || ch == '*' ||
+        ch == '^' || ch == '\\' || ch == ' ' || ch == '\t' || ch == '\r' ||
+        ch == '\n') {
+      return false;
+    }
+  }
+
+  // Validate host and optional :port.
+  nsAutoCString host;
+  nsAutoCString port;
+  if (rest.First() == '[') {
+    int32_t closeBracket = rest.FindChar(']');
+    if (closeBracket <= 1) {
+      return false;
+    }
+    host.Assign(Substring(rest, 0, closeBracket + 1));
+    for (int32_t i = 1; i < closeBracket; ++i) {
+      char ch = rest[i];
+      bool isHex = (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f');
+      if (!isHex && ch != ':' && ch != '.') {
+        return false;
+      }
+    }
+    if (static_cast<size_t>(closeBracket + 1) < rest.Length()) {
+      if (rest[closeBracket + 1] != ':') {
+        return false;
+      }
+      port.Assign(Substring(rest, closeBracket + 2));
+      if (port.IsEmpty()) {
+        return false;
+      }
+    }
+  } else {
+    int32_t colonIdx = rest.FindChar(':');
+    if (colonIdx != kNotFound) {
+      // Reject multiple colons outside bracketed IPv6 literals.
+      if (rest.FindChar(':', colonIdx + 1) != kNotFound) {
+        return false;
+      }
+      host.Assign(Substring(rest, 0, colonIdx));
+      port.Assign(Substring(rest, colonIdx + 1));
+      if (port.IsEmpty()) {
+        return false;
+      }
+    } else {
+      host.Assign(rest);
+    }
+
+    if (host.IsEmpty() || host.First() == '.' || host.Last() == '.' ||
+        host.First() == '-' || host.Last() == '-' ||
+        host.Find("..") != kNotFound) {
+      return false;
+    }
+    for (size_t i = 0; i < host.Length(); ++i) {
+      char ch = host[i];
+      bool ok = (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') ||
+                ch == '.' || ch == '-';
+      if (!ok) {
+        return false;
+      }
+    }
+  }
+
+  bool hasNonDefaultPort = false;
+  uint32_t portNum = 0;
+  if (!port.IsEmpty()) {
+    if (port.Length() > 5) {
+      return false;
+    }
+    for (size_t i = 0; i < port.Length(); ++i) {
+      char ch = port[i];
+      if (ch < '0' || ch > '9') {
+        return false;
+      }
+      portNum = portNum * 10 + static_cast<uint32_t>(ch - '0');
+    }
+    if (portNum == 0 || portNum > 65535) {
+      return false;
+    }
+    bool isDefaultPort =
+        (scheme.EqualsLiteral("https://") && portNum == 443) ||
+        (scheme.EqualsLiteral("http://") && portNum == 80);
+    hasNonDefaultPort = !isDefaultPort;
+  }
+
+  aOut.Assign(scheme);
+  aOut.Append(host);
+  if (hasNonDefaultPort) {
+    aOut.Append(':');
+    aOut.AppendInt(portNum);
+  }
+  return true;
+}
