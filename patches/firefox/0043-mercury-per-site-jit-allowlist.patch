+static bool IsCurrentProcessJitAllowlisted() {
+  if (!XRE_IsContentProcess()) {
+    return false;
+  }
+
+  ContentChild* contentChild = ContentChild::GetSingleton();
+  if (!contentChild) {
+    return false;
+  }
+
+  const RemoteType& remoteType = contentChild->GetRemoteType();
+  // Strictly allow ONLY Fission site-isolated web content processes
+  // (webIsolated=<origin> or webCOOP+COEP=<origin>). Never match prealloc,
+  // shared web, extension, privilegedabout, privilegedmozilla, file, etc.
+  if (!remoteType.HasOrigin() ||
+      (remoteType.GetKind() != RemoteType::Kind::WebContent &&
+       remoteType.GetKind() != RemoteType::Kind::WebCoopCoep)) {
+    return false;
+  }
+
+  // Extract isolated origin and defensively strip any ^... OriginAttributes
+  // suffix (e.g. "https://figma.com^userContextId=1" -> "https://figma.com").
+  nsAutoCString rawOrigin(remoteType.OriginNoSuffix());
+  int32_t caretIdx = rawOrigin.FindChar('^');
+  if (caretIdx != kNotFound) {
+    rawOrigin.Truncate(caretIdx);
+  }
+
+  nsAutoCString processOrigin;
+  if (!NormalizeMercuryJitOrigin(rawOrigin, processOrigin)) {
+    return false;
+  }
+
+  nsAutoCString allowlist;
+  if (NS_FAILED(Preferences::GetCString("mercury.security.jitAllowlist",
+                                        allowlist)) ||
+      allowlist.IsEmpty()) {
+    return false;
+  }
+
+  // Require exact normalized origin equality (never substring/suffix match).
+  for (const nsACString& token : allowlist.Split(',')) {
+    nsAutoCString candidate;
+    if (NormalizeMercuryJitOrigin(token, candidate) &&
+        candidate.Equals(processOrigin)) {
+      return true;
+    }
+  }
+
+  return false;
+}
