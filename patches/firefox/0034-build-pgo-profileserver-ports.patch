+# Mercury: allow overriding the PGO HTTP ports when 8888/8000/8001 are already
+# in use on the build machine. Defaults are unchanged.
+def _pgo_port(env_name, default):
+    raw = os.environ.get(env_name)
+    if not raw:
+        return default
+    try:
+        port = int(raw)
+    except ValueError:
+        raise SystemExit(f"{env_name} must be an integer port, got {raw!r}")
+    if not (1 <= port <= 65535):
+        raise SystemExit(f"{env_name} must be in 1..65535, got {port}")
+    return port
+
+
+PORT = _pgo_port("MERCURY_PGO_PORT", 8888)
+SP3_PORT = _pgo_port("MERCURY_PGO_SP3_PORT", 8000)
+JS3_PORT = _pgo_port("MERCURY_PGO_JS3_PORT", 8001)
 
