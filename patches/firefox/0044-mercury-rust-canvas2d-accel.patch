+// Mercury Rust-first fast-path: directly tessellate axis-aligned stroked
+// rounded (or sharp) rects via mercury_aa_stroke_stroked_rounded_rect.
+bool SharedContextWebgl::StrokeRoundedRectAccel(
+    const Rect& aRect, float aRx, float aRy, const Pattern& aPattern,
+    const StrokeOptions& aStrokeOptions, const DrawOptions& aOptions) {
+  WGR::OutputVertex* outputBuffer = mWGROutputBuffer.get();
+  if (!mPathAAStroke || !outputBuffer || mPathVertexCapacity == 0 ||
+      aRect.width <= 0.0f || aRect.height <= 0.0f || aRx < 0.0f ||
+      aRy < 0.0f || aOptions.mAntialiasMode == AntialiasMode::NONE ||
+      SupportsAAStroke(aPattern, aOptions, aStrokeOptions, false) !=
+          AAStrokeMode::Geometry) {
+    return false;
+  }
+  const Matrix& currentTransform = mCurrentTarget->GetTransform();
+  if (currentTransform._12 != 0.0f || currentTransform._21 != 0.0f ||
+      currentTransform._11 <= 0.0f ||
+      currentTransform._11 != currentTransform._22) {
+    return false;
+  }
+  float scale = currentTransform._11;
+  float strokeWidth = aStrokeOptions.mLineWidth * scale;
+  if (strokeWidth <= 0.0f || !std::isfinite(strokeWidth) ||
+      aStrokeOptions.mMiterLimit <= 0.0f ||
+      !std::isfinite(aStrokeOptions.mMiterLimit)) {
+    return false;
+  }
+  Point topLeft = currentTransform.TransformPoint(aRect.TopLeft());
+  float w = aRect.width * scale;
+  float h = aRect.height * scale;
+  float rx = aRx * scale;
+  float ry = aRy * scale;
+  if (!std::isfinite(topLeft.x) || !std::isfinite(topLeft.y) ||
+      !std::isfinite(w) || !std::isfinite(h) || !std::isfinite(rx) ||
+      !std::isfinite(ry) || w <= 0.0f || h <= 0.0f) {
+    return false;
+  }
+  float pad = strokeWidth + 2.0f;
+  Rect bounds(topLeft.x - pad, topLeft.y - pad, w + 2.0f * pad,
+              h + 2.0f * pad);
+  if (!RectInsidePrecisionLimits(bounds)) {
+    return false;
+  }
+  IntRect viewport(IntPoint(), mViewportSize);
+  IntRect intBounds = RoundedOut(bounds).Intersect(viewport);
+  if (intBounds.IsEmpty()) {
+    return true;
+  }
+  size_t outputBufferCapacity =
+      mPathVertexCapacity / sizeof(WGR::OutputVertex);
+  AAStroke::StrokeStyle style = {strokeWidth,
+                                 ToAAStrokeLineCap(aStrokeOptions.mLineCap),
+                                 ToAAStrokeLineJoin(aStrokeOptions.mLineJoin),
+                                 aStrokeOptions.mMiterLimit};
+  AAStroke::VertexBuffer vb = AAStroke::mercury_aa_stroke_stroked_rounded_rect(
+      topLeft.x - float(intBounds.x), topLeft.y - float(intBounds.y), w, h, rx,
+      ry, &style, (AAStroke::OutputVertex*)outputBuffer, outputBufferCapacity);
+  if (vb.len == 0 || vb.len > outputBufferCapacity) {
+    return false;
+  }
+  return UploadAndDrawPathVertices((const uint8_t*)outputBuffer, vb.len,
+                                   intBounds, aPattern, aOptions);
 }
 
