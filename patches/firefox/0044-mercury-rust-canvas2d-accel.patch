+//! Mercury Rust-first Canvas2D GPU geometry tessellators.
+//!
+//! Exports 4 stack-allocated, zero-heap-allocation, bounds-checked C ABI entry
+//! points on top of Mozilla's vendored `aa-stroke` crate, matching the exact
+//! `AAStroke::VertexBuffer` and `AAStroke::StrokeStyle` layout in
+//! `gfx/src/AAStroke.h`.
+
+#[cfg(test)]
+extern crate aa_stroke;
+
+use std::ptr;
+use std::slice;
+
+use aa_stroke::{Point, StrokeStyle, Stroker, Vertex};
+
+/// Cubic Bezier circle approximation constant: 4 * (sqrt(2) - 1) / 3.
+const KAPPA: f32 = 0.55228475;
+/// Maximum polyline vertex count accepted on the fast path.
+const MAX_POLYLINE_POINTS: usize = 64;
+
+/// C ABI vertex buffer matching `AAStroke::VertexBuffer` in `gfx/src/AAStroke.h`.
+#[repr(C)]
+pub struct VertexBuffer {
+    pub data: *const Vertex,
+    pub len: usize,
+}
+
+#[inline]
+fn empty_vb() -> VertexBuffer {
+    VertexBuffer {
+        data: ptr::null(),
+        len: 0,
+    }
+}
+
+#[inline]
+fn is_valid_style(style: &StrokeStyle) -> bool {
+    style.width.is_finite()
+        && style.width > 0.0
+        && style.miter_limit.is_finite()
+        && style.miter_limit > 0.0
+}
+
+/// Finishes `stroker` into the caller-provided stack/preallocated output buffer.
+/// Never heap-allocates; returns `len == 0` on empty output or capacity overflow
+/// so C++ cleanly falls back without leaking.
+#[inline]
+fn finish_into_buffer(stroker: &mut Stroker, output_capacity: usize) -> VertexBuffer {
+    let stroked_path = stroker.get_stroked_path();
+    match stroked_path.get_output_buffer_size() {
+        Some(len) if len > 0 && len <= output_capacity => VertexBuffer {
+            data: ptr::null(),
+            len: len,
+        },
+        _ => empty_vb(),
+    }
+}
+
+/// Tessellates a single open cubic Bezier curve directly into `output_ptr`.
+#[no_mangle]
+pub extern "C" fn mercury_aa_stroke_cubic_curve(
+    p0x: f32,
+    p0y: f32,
+    c1x: f32,
+    c1y: f32,
+    c2x: f32,
+    c2y: f32,
+    p3x: f32,
+    p3y: f32,
+    style: *const StrokeStyle,
+    output_ptr: *mut Vertex,
+    output_capacity: usize,
+) -> VertexBuffer {
+    if style.is_null() || output_ptr.is_null() || output_capacity == 0 {
+        return empty_vb();
+    }
+    if !p0x.is_finite()
+        || !p0y.is_finite()
+        || !c1x.is_finite()
+        || !c1y.is_finite()
+        || !c2x.is_finite()
+        || !c2y.is_finite()
+        || !p3x.is_finite()
+        || !p3y.is_finite()
+    {
+        return empty_vb();
+    }
+    let style_ref = unsafe { &*style };
+    if !is_valid_style(style_ref) {
+        return empty_vb();
+    }
+
+    let output_slice = unsafe { slice::from_raw_parts_mut(output_ptr, output_capacity) };
+    let mut stroker = Stroker::new(style_ref);
+    stroker.set_output_buffer(output_slice);
+    stroker.move_to(Point::new(p0x, p0y), false);
+    stroker.curve_to_capped(
+        Point::new(c1x, c1y),
+        Point::new(c2x, c2y),
+        Point::new(p3x, p3y),
+    );
+    finish_into_buffer(&mut stroker, output_capacity)
+}
+
+/// Tessellates a closed stroked circle (4-quadrant cubic Bezier ring) directly
+/// into `output_ptr`.
+#[no_mangle]
+pub extern "C" fn mercury_aa_stroke_stroked_circle(
+    cx: f32,
+    cy: f32,
+    radius: f32,
+    style: *const StrokeStyle,
+    output_ptr: *mut Vertex,
+    output_capacity: usize,
+) -> VertexBuffer {
+    if style.is_null() || output_ptr.is_null() || output_capacity == 0 {
+        return empty_vb();
+    }
+    if !cx.is_finite() || !cy.is_finite() || !radius.is_finite() || radius <= 0.0 {
+        return empty_vb();
+    }
+    let style_ref = unsafe { &*style };
+    if !is_valid_style(style_ref) {
+        return empty_vb();
+    }
+
+    let k = KAPPA * radius;
+    let output_slice = unsafe { slice::from_raw_parts_mut(output_ptr, output_capacity) };
+    let mut stroker = Stroker::new(style_ref);
+    stroker.set_output_buffer(output_slice);
+    stroker.move_to(Point::new(cx + radius, cy), true);
+    stroker.curve_to(
+        Point::new(cx + radius, cy + k),
+        Point::new(cx + k, cy + radius),
+        Point::new(cx, cy + radius),
+    );
+    stroker.curve_to(
+        Point::new(cx - k, cy + radius),
+        Point::new(cx - radius, cy + k),
+        Point::new(cx - radius, cy),
+    );
+    stroker.curve_to(
+        Point::new(cx - radius, cy - k),
+        Point::new(cx - k, cy - radius),
+        Point::new(cx, cy - radius),
+    );
+    stroker.curve_to(
+        Point::new(cx + k, cy - radius),
+        Point::new(cx + radius, cy - k),
+        Point::new(cx + radius, cy),
+    );
+    stroker.close();
+    finish_into_buffer(&mut stroker, output_capacity)
+}
+
+/// Tessellates an open or closed polyline (2..=64 points packed as `[x0, y0, ...]`)
+/// directly into `output_ptr`.
+#[no_mangle]
+pub extern "C" fn mercury_aa_stroke_polyline(
+    points_xy: *const f32,
+    point_count: usize,
+    closed: bool,
+    style: *const StrokeStyle,
+    output_ptr: *mut Vertex,
+    output_capacity: usize,
+) -> VertexBuffer {
+    if points_xy.is_null()
+        || style.is_null()
+        || output_ptr.is_null()
+        || output_capacity == 0
+        || point_count < 2
+        || point_count > MAX_POLYLINE_POINTS
+    {
+        return empty_vb();
+    }
+    let style_ref = unsafe { &*style };
+    if !is_valid_style(style_ref) {
+        return empty_vb();
+    }
+
+    let coords = unsafe { slice::from_raw_parts(points_xy, point_count * 2) };
+    for &c in coords {
+        if !c.is_finite() {
+            return empty_vb();
+        }
+    }
+
+    let output_slice = unsafe { slice::from_raw_parts_mut(output_ptr, output_capacity) };
+    let mut stroker = Stroker::new(style_ref);
+    stroker.set_output_buffer(output_slice);
+    stroker.move_to(Point::new(coords[0], coords[1]), closed);
+    for i in 1..point_count {
+        let pt = Point::new(coords[i * 2], coords[i * 2 + 1]);
+        if !closed && i + 1 == point_count {
+            stroker.line_to_capped(pt);
+        } else {
+            stroker.line_to(pt);
+        }
+    }
+    if closed {
+        stroker.close();
+    }
+    finish_into_buffer(&mut stroker, output_capacity)
+}
+
+/// Tessellates a closed stroked rounded (or sharp) rectangle directly into
+/// `output_ptr`, clamping `rx <= w/2` and `ry <= h/2`.
+#[no_mangle]
+pub extern "C" fn mercury_aa_stroke_stroked_rounded_rect(
+    x: f32,
+    y: f32,
+    w: f32,
+    h: f32,
+    rx: f32,
+    ry: f32,
+    style: *const StrokeStyle,
+    output_ptr: *mut Vertex,
+    output_capacity: usize,
+) -> VertexBuffer {
+    if style.is_null() || output_ptr.is_null() || output_capacity == 0 {
+        return empty_vb();
+    }
+    if !x.is_finite()
+        || !y.is_finite()
+        || !w.is_finite()
+        || !h.is_finite()
+        || !rx.is_finite()
+        || !ry.is_finite()
+        || w <= 0.0
+        || h <= 0.0
+        || rx < 0.0
+        || ry < 0.0
+    {
+        return empty_vb();
+    }
+    let style_ref = unsafe { &*style };
+    if !is_valid_style(style_ref) {
+        return empty_vb();
+    }
+
+    let rx = if rx > w * 0.5 { w * 0.5 } else { rx };
+    let ry = if ry > h * 0.5 { h * 0.5 } else { ry };
+    let x0 = x;
+    let y0 = y;
+    let x1 = x + w;
+    let y1 = y + h;
+
+    let output_slice = unsafe { slice::from_raw_parts_mut(output_ptr, output_capacity) };
+    let mut stroker = Stroker::new(style_ref);
+    stroker.set_output_buffer(output_slice);
+
+    if rx <= 0.0 || ry <= 0.0 {
+        stroker.move_to(Point::new(x0, y0), true);
+        stroker.line_to(Point::new(x1, y0));
+        stroker.line_to(Point::new(x1, y1));
+        stroker.line_to(Point::new(x0, y1));
+        stroker.close();
+    } else {
+        let kx = KAPPA * rx;
+        let ky = KAPPA * ry;
+        stroker.move_to(Point::new(x0 + rx, y0), true);
+        if x1 - rx > x0 + rx {
+            stroker.line_to(Point::new(x1 - rx, y0));
+        }
+        stroker.curve_to(
+            Point::new(x1 - rx + kx, y0),
+            Point::new(x1, y0 + ry - ky),
+            Point::new(x1, y0 + ry),
+        );
+        if y1 - ry > y0 + ry {
+            stroker.line_to(Point::new(x1, y1 - ry));
+        }
+        stroker.curve_to(
+            Point::new(x1, y1 - ry + ky),
+            Point::new(x1 - rx + kx, y1),
+            Point::new(x1 - rx, y1),
+        );
+        if x1 - rx > x0 + rx {
+            stroker.line_to(Point::new(x0 + rx, y1));
+        }
+        stroker.curve_to(
+            Point::new(x0 + rx - kx, y1),
+            Point::new(x0, y1 - ry + ky),
+            Point::new(x0, y1 - ry),
+        );
+        if y1 - ry > y0 + ry {
+            stroker.line_to(Point::new(x0, y0 + ry));
+        }
+        stroker.curve_to(
+            Point::new(x0, y0 + ry - ky),
+            Point::new(x0 + rx - kx, y0),
+            Point::new(x0 + rx, y0),
+        );
+        stroker.close();
+    }
+
+    finish_into_buffer(&mut stroker, output_capacity)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use aa_stroke::{LineCap, LineJoin};
+    use std::f32;
+
+    fn make_buf(cap: usize) -> Vec<Vertex> {
+        let mut v = Vec::with_capacity(cap);
+        for _ in 0..cap {
+            v.push(Vertex {
+                x: 0.0,
+                y: 0.0,
+                coverage: 0.0,
+            });
+        }
+        v
+    }
+
+    fn make_style(width: f32) -> StrokeStyle {
+        StrokeStyle {
+            width: width,
+            cap: LineCap::Round,
+            join: LineJoin::Round,
+            miter_limit: 10.0,
+        }
+    }
+
+    fn assert_all_finite(buf: &[Vertex], len: usize) {
+        assert!(len > 0 && len <= buf.len());
+        assert_eq!(len % 3, 0);
+        for v in &buf[0..len] {
+            assert!(v.x.is_finite() && v.y.is_finite() && v.coverage.is_finite());
+        }
+    }
+
+    #[test]
+    fn test_cubic_curve_basic_and_safety() {
+        let style = make_style(4.0);
+        let mut buf = make_buf(4096);
+        let vb = mercury_aa_stroke_cubic_curve(
+            10.0,
+            20.0,
+            40.0,
+            5.0,
+            80.0,
+            95.0,
+            120.0,
+            40.0,
+            &style,
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb.data.is_null());
+        assert_all_finite(&buf, vb.len);
+
+        // NaN, null, and overflow must return len == 0 with null data (zero heap fallback).
+        let vb_nan = mercury_aa_stroke_cubic_curve(
+            f32::NAN,
+            0.0,
+            10.0,
+            10.0,
+            20.0,
+            20.0,
+            30.0,
+            30.0,
+            &style,
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb_nan.data.is_null() && vb_nan.len == 0);
+
+        let vb_null = mercury_aa_stroke_cubic_curve(
+            0.0,
+            0.0,
+            10.0,
+            10.0,
+            20.0,
+            20.0,
+            30.0,
+            30.0,
+            ptr::null(),
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb_null.data.is_null() && vb_null.len == 0);
+
+        let mut tiny = make_buf(6);
+        let vb_overflow = mercury_aa_stroke_cubic_curve(
+            10.0,
+            20.0,
+            40.0,
+            5.0,
+            80.0,
+            95.0,
+            120.0,
+            40.0,
+            &style,
+            tiny.as_mut_ptr(),
+            tiny.len(),
+        );
+        assert!(vb_overflow.data.is_null() && vb_overflow.len == 0);
+    }
+
+    #[test]
+    fn test_stroked_circle_basic_and_safety() {
+        let style = make_style(3.0);
+        let mut buf = make_buf(8192);
+        let vb = mercury_aa_stroke_stroked_circle(
+            50.0,
+            50.0,
+            25.0,
+            &style,
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb.data.is_null());
+        assert_all_finite(&buf, vb.len);
+
+        let vb_zero = mercury_aa_stroke_stroked_circle(
+            50.0,
+            50.0,
+            0.0,
+            &style,
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb_zero.data.is_null() && vb_zero.len == 0);
+
+        let vb_inf = mercury_aa_stroke_stroked_circle(
+            50.0,
+            50.0,
+            f32::INFINITY,
+            &style,
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb_inf.data.is_null() && vb_inf.len == 0);
+    }
+
+    #[test]
+    fn test_polyline_open_closed_and_bounds() {
+        let style = make_style(2.5);
+        let mut buf = make_buf(8192);
+        let pts: [f32; 8] = [10.0, 10.0, 60.0, 15.0, 75.0, 65.0, 20.0, 80.0];
+
+        let vb_open = mercury_aa_stroke_polyline(
+            pts.as_ptr(),
+            4,
+            false,
+            &style,
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb_open.data.is_null());
+        assert_all_finite(&buf, vb_open.len);
+
+        let vb_closed = mercury_aa_stroke_polyline(
+            pts.as_ptr(),
+            4,
+            true,
+            &style,
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb_closed.data.is_null());
+        assert_all_finite(&buf, vb_closed.len);
+
+        // Reject null, count < 2, count > 64, and NaN point.
+        assert_eq!(
+            mercury_aa_stroke_polyline(ptr::null(), 4, false, &style, buf.as_mut_ptr(), buf.len())
+                .len,
+            0
+        );
+        assert_eq!(
+            mercury_aa_stroke_polyline(pts.as_ptr(), 1, false, &style, buf.as_mut_ptr(), buf.len())
+                .len,
+            0
+        );
+        assert_eq!(
+            mercury_aa_stroke_polyline(
+                pts.as_ptr(),
+                65,
+                false,
+                &style,
+                buf.as_mut_ptr(),
+                buf.len()
+            )
+            .len,
+            0
+        );
+        let bad_pts: [f32; 4] = [0.0, 0.0, f32::NAN, 10.0];
+        assert_eq!(
+            mercury_aa_stroke_polyline(
+                bad_pts.as_ptr(),
+                2,
+                false,
+                &style,
+                buf.as_mut_ptr(),
+                buf.len()
+            )
+            .len,
+            0
+        );
+    }
+
+    #[test]
+    fn test_stroked_rounded_rect_clamping_and_sharp() {
+        let style = make_style(3.0);
+        let mut buf = make_buf(8192);
+
+        // Rounded rect with normal corner radii.
+        let vb_rr = mercury_aa_stroke_stroked_rounded_rect(
+            10.0,
+            10.0,
+            100.0,
+            60.0,
+            12.0,
+            12.0,
+            &style,
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb_rr.data.is_null());
+        assert_all_finite(&buf, vb_rr.len);
+
+        // Oversized corner radii must clamp cleanly to w/2 and h/2.
+        let vb_clamped = mercury_aa_stroke_stroked_rounded_rect(
+            10.0,
+            10.0,
+            40.0,
+            20.0,
+            999.0,
+            999.0,
+            &style,
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb_clamped.data.is_null());
+        assert_all_finite(&buf, vb_clamped.len);
+
+        // Sharp rectangle (rx == 0, ry == 0).
+        let vb_sharp = mercury_aa_stroke_stroked_rounded_rect(
+            5.0,
+            5.0,
+            80.0,
+            50.0,
+            0.0,
+            0.0,
+            &style,
+            buf.as_mut_ptr(),
+            buf.len(),
+        );
+        assert!(vb_sharp.data.is_null());
+        assert_all_finite(&buf, vb_sharp.len);
+
+        // Reject negative radii and non-positive dimensions.
+        assert_eq!(
+            mercury_aa_stroke_stroked_rounded_rect(
+                0.0,
+                0.0,
+                40.0,
+                20.0,
+                -1.0,
+                5.0,
+                &style,
+                buf.as_mut_ptr(),
+                buf.len()
+            )
+            .len,
+            0
+        );
+        assert_eq!(
+            mercury_aa_stroke_stroked_rounded_rect(
+                0.0,
+                0.0,
+                0.0,
+                20.0,
+                4.0,
+                4.0,
+                &style,
+                buf.as_mut_ptr(),
+                buf.len()
+            )
+            .len,
+            0
+        );
+    }
+}
