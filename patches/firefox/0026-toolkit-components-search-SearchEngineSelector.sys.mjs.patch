 /**
+ * Mercury: returns true for search engines Mercury never offers (Google,
+ * Bing, eBay, Perplexity). Matches on the config identifier and on the
+ * search URL host, so a renamed or new record in a remote config update
+ * is caught too.
+ *
+ * @param {string} [identifier]
+ * @param {string} [searchUrlBase]
+ * @returns {boolean}
+ */
+function mercuryIsBlockedEngine(identifier, searchUrlBase) {
+  if (identifier && /^(google|bing|ebay|perplexity)(\b|[-_])/i.test(identifier)) {
+    return true;
+  }
+  if (searchUrlBase) {
+    try {
+      let host = new URL(searchUrlBase).hostname;
+      if (
+        /(^|\.)google\.[a-z.]+$/i.test(host) ||
+        /(^|\.)bing\.com$/i.test(host) ||
+        /(^|\.)ebay\.[a-z.]+$/i.test(host) ||
+        /(^|\.)perplexity\.ai$/i.test(host)
+      ) {
+        return true;
+      }
+    } catch {}
+  }
+  return false;
+}
