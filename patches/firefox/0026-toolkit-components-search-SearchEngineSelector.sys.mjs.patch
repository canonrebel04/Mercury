 /**
+ * Mercury: returns true for search engines Mercury never offers (Google).
+ * Matches on the config identifier and on the search URL host, so a renamed
+ * or new Google engine record in a remote config update is caught too.
+ *
+ * @param {string} [identifier]
+ * @param {string} [searchUrlBase]
+ * @returns {boolean}
+ */
+function mercuryIsBlockedEngine(identifier, searchUrlBase) {
+  if (identifier && /^google(\b|[-_])/i.test(identifier)) {
+    return true;
+  }
+  if (searchUrlBase) {
+    try {
+      let host = new URL(searchUrlBase).hostname;
+      if (/(^|\.)google\.[a-z.]+$/i.test(host)) {
+        return true;
+      }
+    } catch {}
+  }
+  return false;
+}
