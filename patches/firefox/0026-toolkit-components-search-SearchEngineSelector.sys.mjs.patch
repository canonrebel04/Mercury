+/**
+ * Mercury: returns true for spam/commercial search engines Mercury never offers
+ * (eBay, Perplexity, Amazon). Google & Bing remain selectable (never default),
+ * with partner tracking parameters stripped.
+ */
+function mercuryIsBlockedEngine(identifier, searchUrlBase) {
+  if (identifier && /^(ebay|perplexity|amazon)(\b|[-_])/i.test(identifier)) {
+    return true;
+  }
+  if (searchUrlBase) {
+    try {
+      let host = new URL(searchUrlBase).hostname;
+      if (
+        /(^|\.)ebay\.[a-z.]+$/i.test(host) ||
+        /(^|\.)perplexity\.ai$/i.test(host) ||
+        /(^|\.)amazon\.[a-z.]+$/i.test(host)
+      ) {
+        return true;
+      }
+    } catch {}
+  }
+  return false;
+}
