+    private fun makeBadgeIcon(label: String, bgHex: String): Bitmap {
+        val size = 64
+        val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bmp)
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = Color.parseColor(bgHex)
+            style = Paint.Style.FILL
+        }
+        canvas.drawCircle(size / 2f, size / 2f, size / 2f, paint)
+        val textPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = Color.WHITE
+            textSize = 28f
+            textAlign = Paint.Align.CENTER
+            isFakeBoldText = true
+        }
+        val y = size / 2f - (textPaint.descent() + textPaint.ascent()) / 2f
+        canvas.drawText(label, size / 2f, y, textPaint)
+        return bmp
+    }
+
+    private fun buildMercurySearchEngineList(upstream: List<SearchEngine>): List<SearchEngine> {
+        val blockedPrefixes = listOf("ebay", "perplexity", "amazon")
+        val iconById = upstream.associateBy { it.id.lowercase(Locale.ROOT) }
+        fun iconFor(id: String, badge: String, colorHex: String): Bitmap {
+            return iconById.entries
+                .firstOrNull { (k, _) -> k == id || k.startsWith("$id-") || k.startsWith("${id}_") }
+                ?.value?.icon
+                ?: makeBadgeIcon(badge, colorHex)
+        }
+
+        data class Spec(val id: String, val name: String, val url: String, val badge: String, val color: String)
+        val curated = listOf(
+            Spec("ddg", "DuckDuckGo", "https://duckduckgo.com/?q={searchTerms}", "D", "#DE5833"),
+            Spec("mercury-brave", "Brave Search", "https://search.brave.com/search?q={searchTerms}", "Br", "#FB542B"),
+            Spec("mercury-startpage", "Startpage", "https://www.startpage.com/sp/search?query={searchTerms}", "Sp", "#6573FF"),
+            Spec("mercury-qwant", "Qwant", "https://www.qwant.com/?q={searchTerms}", "Q", "#5C97FF"),
+            Spec("mercury-ecosia", "Ecosia", "https://www.ecosia.org/search?q={searchTerms}", "Ec", "#36ACB8"),
+            Spec("mercury-metager", "MetaGer", "https://metager.org/meta/meta.ger3?eingabe={searchTerms}", "MG", "#FF8000"),
+            Spec("mercury-mojeek", "Mojeek", "https://www.mojeek.com/search?q={searchTerms}", "Mj", "#2E7D32"),
+            Spec("mercury-swisscows", "Swisscows", "https://swisscows.com/en/web?query={searchTerms}", "Sc", "#DF5D5D"),
+            Spec("mercury-gibiru", "Gibiru", "https://gibiru.com/results.html?q={searchTerms}", "Gi", "#D32F2F"),
+            Spec("mercury-privacywall", "PrivacyWall", "https://www.privacywall.org/search/secure/?q={searchTerms}", "PW", "#1565C0"),
+            Spec("mercury-searx-neocities", "SearX Random (neocities)", "https://searx.neocities.org/?q={searchTerms}", "Sx", "#3050FF"),
+            Spec("mercury-searxng-rhscz", "SearXNG (rhscz.eu)", "https://search.rhscz.eu/search?q={searchTerms}", "S1", "#283593"),
+            Spec("mercury-searxng-deggo", "SearXNG (deggo.fyi)", "https://searxng.deggo.fyi/search?q={searchTerms}", "S2", "#283593"),
+            Spec("mercury-searxng-oloke", "SearXNG (oloke.xyz)", "https://searx.oloke.xyz/search?q={searchTerms}", "S3", "#283593"),
+            Spec("mercury-searxng-paulgo", "SearXNG (paulgo.io)", "https://paulgo.io/search?q={searchTerms}", "S4", "#283593"),
+            Spec("mercury-searxng-privau", "SearXNG (priv.au)", "https://priv.au/search?q={searchTerms}", "S5", "#283593"),
+            Spec("mercury-searxng-tiekoetter", "SearXNG (tiekoetter)", "https://searx.tiekoetter.com/search?q={searchTerms}", "S6", "#283593"),
+            Spec("bing", "Bing", "https://www.bing.com/search?q={searchTerms}", "B", "#008373"),
+            Spec("google", "Google", "https://www.google.com/search?q={searchTerms}", "G", "#4285F4"),
+        )
+
+        val result = curated.map { s ->
+            SearchEngine(
+                id = s.id,
+                name = s.name,
+                icon = iconFor(s.id.removePrefix("mercury-"), s.badge, s.color),
+                inputEncoding = "UTF-8",
+                type = SearchEngine.Type.BUNDLED,
+                resultUrls = listOf(s.url),
+                suggestUrl = null,
+                trendingUrl = null,
+                isGeneral = true,
+            )
+        }.toMutableList()
+
+        // Keep Wikipedia if present upstream; drop Google/Bing duplicates & eBay/Amazon/Perplexity
+        val usedIds = result.map { it.id }.toSet()
+        upstream.forEach { e ->
+            val low = e.id.lowercase(Locale.ROOT)
+            if (low.startsWith("wikipedia") && e.id !in usedIds && blockedPrefixes.none { low.startsWith(it) }) {
+                result.add(e)
+            }
+        }
+        return result
+    }
