# Mercury-only modules:
# - MercuryUpdateCheck: notifies the user when a newer Mercury release is
#   published.
# - MercuryHardened: the optional Hardened mode switch in Settings.
MOZ_SRC_FILES += [
    "MercuryHardened.sys.mjs",
    "MercuryUpdateCheck.sys.mjs",
]
